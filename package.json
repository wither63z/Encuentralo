{
  "name": "encuentralo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verificar": "node scripts/verificar-lineas.mjs",
    "test": "vitest run",
    "auditar": "node scripts/auditar-seguridad.mjs",
    "verificar:supabase": "node --env-file-if-exists=.env scripts/verificar-supabase.mjs",
    "escritorio": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win portable",
    "apk:preparar": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@clerk/clerk-react": "^5.61.12",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "main": "electron/main.cjs",
  "description": "Encuéntralo: objetos perdidos del Técnico Salesiano",
  "author": "Equipo Encuéntralo",
  "build": {
    "appId": "ec.tecnicosalesiano.encuentralo",
    "productName": "Encuentralo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Encuentralo-${version}.exe"
    }
  }
}
