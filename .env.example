# Copia este archivo como .env. Con VITE_USE_MOCK=true todo funciona sin claves.
VITE_USE_MOCK=true
# Solo si se usa Supabase (clave PUBLICABLE, nunca service_role):
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable
# Solo si se usa Clerk (clave publicable pk_test_...):
VITE_CLERK_PUBLISHABLE_KEY=
