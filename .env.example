# Copia este archivo como .env (NUNCA subas .env a git). Con VITE_USE_MOCK=true todo funciona sin claves.
# Demo del jurado / plan B sin internet: deja VITE_USE_MOCK=true.
VITE_USE_MOCK=true

# Supabase (Project Settings → API Keys). Solo la clave PUBLICABLE (sb_publishable_...).
# NUNCA pegues aquí la secret key ni la service_role: el front la expondría a cualquiera.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU-CLAVE

# Clerk (Dashboard → API Keys). Solo la Publishable key (pk_test_... o pk_live_...).
# NUNCA la Secret key (sk_...). Vacío = sin Clerk.
VITE_CLERK_PUBLISHABLE_KEY=
